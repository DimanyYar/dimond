# Production front of dimond (ADR 0022). Caddy serves CSS and scripts itself and passes
# everything else to Django. SITE_ADDRESS decides who does HTTPS: a domain name makes Caddy
# get and renew the certificate itself; ":80" leaves HTTPS to a proxy in front of it.
{
	servers {
		# A proxy in front reaches Caddy from a private address. Trusting it keeps its
		# X-Forwarded-Proto: https, which Django needs for secure cookies and form checks.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# The largest real request: 5 videos of 20 MB each (apps/files/uploads.py), plus the form.
	request_body {
		max_size 128MB
	}

	handle_path /static/* {
		root * /srv/static
		# File names carry no version, so browsers ask each time; unchanged files answer 304.
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
