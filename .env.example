# Copy to .env for local development: cp .env.example .env
# Production values live only on the server.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin-local/
# Public address of the site; sign-in links in emails start with it.
SITE_URL=http://localhost:8000

POSTGRES_DB=dimond
POSTGRES_USER=dimond
POSTGRES_PASSWORD=dimond
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local mail goes to Mailpit: open http://localhost:8025 to read it.
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL="Dimon <dimon@localhost>"
# Empty = mail goes to the SMTP server above. Set on the server to send through Resend (ADR 0009);
# then DEFAULT_FROM_EMAIL must be on the domain verified in Resend, or dimond will not start.
RESEND_API_KEY=
# Emails a day your Resend plan allows; Logs · Emails shows how many went out today.
EMAIL_DAILY_LIMIT=100
# Signing secret of the webhook in Resend (whsec_…): delivered, bounced and spam reports in
# Logs · Emails (ADR 0021). Empty = the webhook is off.
RESEND_WEBHOOK_SECRET=

# Private folder for attachments; never served directly. Default: uploads/ in the project.
FILES_ROOT=uploads

# Jira. Used only when "Jira" is chosen in the admin (Tracker settings); empty = demo tasks.
# The address must start with https://. Never commit real values.
TRACKER_JIRA_URL=
TRACKER_JIRA_USERNAME=
TRACKER_JIRA_PASSWORD=
# The secret in the address of the Jira webhook (ADR 0020); empty = no webhook, polling only.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRACKER_JIRA_WEBHOOK_TOKEN=

LOG_LEVEL=INFO
