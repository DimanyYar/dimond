# Copy to .env for local development: cp .env.example .env
# Production values live only on the server.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin-local/

POSTGRES_DB=dimond
POSTGRES_USER=dimond
POSTGRES_PASSWORD=dimond
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local mail goes to Mailpit: open http://localhost:8025 to read it.
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Dimon <dimon@localhost>

LOG_LEVEL=INFO
